/**
 * Implements hook_entity_type_build().
 */
function farm_pcsc_entity_type_build(array &$entity_types) {
  /** @var \Drupal\Core\Entity\EntityTypeInterface[] $entity_types */
  if (!empty($entity_types['plan_record'])) {

    // Set the views data handler class to FarmEntityViewsData.
    $entity_types['plan_record']->setHandlerClass('views_data', FarmEntityViewsData::class);

    // Add view and edit routes for plan records.
    $entity_types['plan_record']->setHandlerClass('view_builder',EntityViewBuilder::class);
    $entity_types['plan_record']->setHandlerClass('local_task_provider', [
      'default' => DefaultEntityLocalTaskProvider::class,
    ]);
    $entity_types['plan_record']->setLinkTemplate('canonical', '/plan/record/{plan_record}');
  }

}

/**
 * Define bundle classes for plan records.
 *
 * @return array
 *   Returns an array of bundle classes keyed by bundle ID.
 */
function farm_pcsc_plan_record_bundle_classes() {
  return [
    'pcsc_field' => PcscField::class,
    'pcsc_commodity' => PcscCommodity::class,
    'pcsc_farm_benefit' => PcscFarmBenefit::class,
    'pcsc_farm_summary' => PcscFarmSummary::class,
    'pcsc_field_summary' => PcscFieldSummary::class,
    'pcsc_field_practice_327' => PcscFieldPractice327::class,
    'pcsc_field_practice_328' => PcscFieldPractice328::class,
    'pcsc_field_practice_329' => PcscFieldPractice329::class,
    'pcsc_field_practice_336' => PcscFieldPractice336::class,
    'pcsc_field_practice_340' => PcscFieldPractice340::class,
    'pcsc_field_practice_345' => PcscFieldPractice345::class,
    'pcsc_field_practice_484' => PcscFieldPractice484::class,
    'pcsc_field_practice_528' => PcscFieldPractice528::class,
    'pcsc_field_practice_590' => PcscFieldPractice590::class,
  ];
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function farm_pcsc_entity_bundle_info_alter(array &$bundles): void {
  foreach (farm_pcsc_plan_record_bundle_classes() as $bundle => $class) {
    if (isset($bundles['plan_record'][$bundle])) {
      $bundles['plan_record'][$bundle]['class'] = $class;
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function farm_pcsc_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  // Don't allow changing "Field" or "Plan" in our plan_record entity forms.
  if (in_array($form_id, array_map(function ($bundle) {
    return 'plan_record_' . $bundle . '_edit_form';
  }, array_keys(farm_pcsc_plan_record_bundle_classes())))) {
    $form['plan']['#access'] = FALSE;
    $form['pcsc_field']['#access'] = FALSE;
  }

  // Update County options when State changes in Producer and Field edit forms.
  if (in_array($form_id, ['plan_pcsc_producer_edit_form', 'plan_record_pcsc_field_edit_form'])) {
    $form['pcsc_county']['#attributes']['id'] = 'pcsc-county-wrapper';
    $form['pcsc_state']['widget']['#ajax'] = [
      'callback' => 'farm_pcsc_county_ajax_callback',
      'wrapper' => 'pcsc-county-wrapper',
    ];
    if ($value = $form_state->getValue('pcsc_state')) {
      if (is_array($value) && isset($value[0]['value'])) {
        $value = $value[0]['value'];
      }
      $options = farm_pcsc_state_county_options($value);
      $form['pcsc_county']['widget']['#options'] = array_combine($options, $options);
      $form['pcsc_county']['widget']['#default_value'] = NULL;
    }
  }
}

/**
 * Ajax callback for replacing county field in plan+field edit forms.
 */
function farm_pcsc_county_ajax_callback(array $form, FormStateInterface $form_state) {
  return $form['pcsc_county'];
}

/**
 * Implements hook_farm_ui_theme_region_items().
 */
function farm_pcsc_farm_ui_theme_region_items(string $entity_type) {
  return [
    'bottom' => [
      'pcsc_producer_fields_view',
      'pcsc_farm_benefits_view',
      'pcsc_farm_summaries_view',
      'pcsc_field_summaries_view',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function farm_pcsc_plan_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->bundle() === 'pcsc_producer' && $view_mode === 'full') {

    // Add producer fields.
    $view = Drupal\views\Views::getView('pcsc_producer_fields');
    if (is_object($view)) {
      $view->setDisplay('block');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $render_array = $view->render();

      // Check to ensure the view results are not empty.
      $build['pcsc_producer_fields_view'] = [
        '#type'   => 'details',
        '#title'  => t('Producer Fields'),
        '#open'   => TRUE,
        'content' => $render_array,
        '#cache' => ['tags' => $view->getCacheTags()],
      ];
    }

    // Add farm benefits.
    $view = Drupal\views\Views::getView('pcsc_farm_benefits');
    if (is_object($view)) {
      $view->setDisplay('block');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $render_array = $view->render();

      // Check to ensure the view results are not empty.
      $build['pcsc_farm_benefits_view'] = [
        '#type'   => 'details',
        '#title'  => t('Farm Benefits'),
        '#open'   => TRUE,
        'content' => $render_array,
        '#cache' => ['tags' => $view->getCacheTags()],
      ];
    }

    // Add farm summaries.
    $view = Drupal\views\Views::getView('pcsc_farm_summaries');
    if (is_object($view)) {
      $view->setDisplay('block');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $render_array = $view->render();

      // Check to ensure the view results are not empty.
      $build['pcsc_farm_summaries_view'] = [
        '#type'   => 'details',
        '#title'  => t('Farm Summaries'),
        '#open'   => TRUE,
        'content' => $render_array,
        '#cache' => ['tags' => $view->getCacheTags()],
      ];;
    }

    // Add field summaries.
    $view = Drupal\views\Views::getView('pcsc_field_summaries');
    if (is_object($view)) {
      $view->setDisplay('block');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $render_array = $view->render();

      // Check to ensure the view results are not empty.
      $build['pcsc_field_summaries_view'] = [
        '#type'   => 'details',
        '#title'  => t('Field Summaries'),
        '#open'   => TRUE,
        'content' => $render_array,
        '#cache' => ['tags' => $view->getCacheTags()],
      ];
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function farm_pcsc_plan_record_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {

  // Add plan link on all plan records.
  if (in_array($view_mode, ['full'])) {

    // Set page title.
    $build['#title'] = $entity->label();

    // Render link to the plan.
    /** @var \Drupal\plan\Entity\PlanInterface $plan */
    if ($plan = $entity->get('plan')->first()?->entity) {
      $build['plan_link'] = [
        '#type' => 'link',
        '#title' => "Producer: {$plan->label()}",
        '#url' => $plan->toUrl(),
        '#weight' => -100,
      ];
    }
  }

  // Add view tables to field enrollments.
  if ($entity->bundle() === 'pcsc_field' && in_array($view_mode, ['full'])) {

    // Add practices.
    $view = Drupal\views\Views::getView('pcsc_field_practices');
    if (is_object($view)) {
      $view->setDisplay('block');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $render_array = $view->render();

      // Check to ensure the view results are not empty.
      $build['pcsc_field_practices_view'] = [
        '#type'   => 'details',
        '#title'  => t('Practices'),
        '#open'   => TRUE,
        'content' => $render_array,
      ];
      // To ensure the render array is cached tag it with the configuration tags.
      $build['#cache']['tags'] = $view->getCacheTags();
    }

    // Add commodities.
    $view = Drupal\views\Views::getView('pcsc_field_commodities');
    if (is_object($view)) {
      $view->setDisplay('block');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $render_array = $view->render();

      // Check to ensure the view results are not empty.
      $build['pcsc_field_commodities_view'] = [
        '#type'   => 'details',
        '#title'  => t('Commodities'),
        '#open'   => TRUE,
        'content' => $render_array,
      ];
      // To ensure the render array is cached tag it with the configuration tags.
      $build['#cache']['tags'] = $view->getCacheTags();
    }
  }
}

/**
 * Helper function for building allowed_values options.
 *
 * @param array $options
 *   A non-associative array of allowed values.
 *
 * @return array
 *   Returns an array with $options as both the keys and values.
 */
function farm_pcsc_allowed_values_helper(array $options) {
  return array_combine($options, $options);
}

/**
 * Allowed values callback function for pcsc_state field.
 *
 * @param \Drupal\Core\Field\FieldStorageDefinitionInterface $definition
 *   The field storage definition.
 * @param \Drupal\Core\Entity\ContentEntityInterface|null $entity
 *   The entity being created if applicable.
 * @param bool $cacheable
 *   Boolean indicating if the allowed values can be cached. Defaults to TRUE.
 *
 * @return array
 *   Returns an array of allowed values for use in form select options.
 */
function farm_pcsc_state_field_allowed_values(FieldStorageDefinitionInterface $definition, ContentEntityInterface $entity = NULL, bool &$cacheable = TRUE) {
  $options = farm_pcsc_state_options();
  return array_combine($options, $options);
}

/**
 * Allowed values callback function for pcsc_county field.
 *
 * @param \Drupal\Core\Field\FieldStorageDefinitionInterface $definition
 *   The field storage definition.
 * @param \Drupal\Core\Entity\ContentEntityInterface|null $entity
 *   The entity being created if applicable.
 * @param bool $cacheable
 *   Boolean indicating if the allowed values can be cached. Defaults to TRUE.
 *
 * @return array
 *   Returns an array of allowed values for use in form select options.
 */
function farm_pcsc_county_field_allowed_values(FieldStorageDefinitionInterface $definition, ContentEntityInterface $entity = NULL, bool &$cacheable = TRUE) {
  // Return valid county options if the entity has a state set.
  if ($entity && $entity->hasField('pcsc_state')) {
    $cacheable = FALSE;
    if ($state = $entity->get('pcsc_state')->getString()) {
      $options = farm_pcsc_state_county_options($state);
      return array_combine($options, $options);
    }
  }
  return [];
}

/**
 * Define practice type options.
 *
 * @return array
 *   Returns an array of practice type options, as described in the "Practice
 *   Type X" column of the workbook, keyed by plan_record bundle.
 */
function farm_pcsc_practice_type_options() {
  return [
    'pcsc_field_practice_327' => t('327, Conservation Cover'),
    'pcsc_field_practice_328' => t('328, Conservation Crop Rotation'),
    'pcsc_field_practice_329' => t('329, Residue and Tillage Management, No Till'),
    'pcsc_field_practice_336' => t('336, Soil Carbon Amendment'),
    'pcsc_field_practice_340' => t('340, Cover Crop'),
    'pcsc_field_practice_345' => t('345, Residue and Tillage Management, Reduced Till'),
    'pcsc_field_practice_484' => t('484, Mulching'),
    'pcsc_field_practice_528' => t('528, Prescribed Grazing'),
    'pcsc_field_practice_590' => t('590, Nutrient Management'),
  ];
}

