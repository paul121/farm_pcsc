/**
 * Returns an array of PCSC county options for a given state.
 *
 * @param string $state
 *   The state.
 *
 * @return string[]
 *   Array of county options.
 */
function farm_pcsc_state_county_options(string $state): array {
  return farm_pcsc_state_county_mapping()[$state] ?? [];
}

